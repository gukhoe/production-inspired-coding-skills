{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:software-assurance-auditor:report:1.0",
  "title": "Software Assurance Audit Report template 1.0",
  "type": "object",
  "required": ["schema_version", "report_template_version", "standard_version", "input_schema_version", "scope", "revision", "outcome", "scorecard", "controls", "boundaries", "gates", "investigations", "risks", "evidence_index", "scope_issues", "limitations"],
  "properties": {
    "schema_version": {"const": 2},
    "report_template_version": {"const": "1.0"},
    "standard_version": {"const": "0.2.0"},
    "input_schema_version": {"enum": [1, 2]},
    "scope": {"type": "string", "minLength": 1},
    "revision": {"type": "string", "minLength": 1},
    "outcome": {"enum": ["needs_attention", "incomplete", "reviewed_scope_supported"]},
    "scope_issues": {"type": "array", "items": {"type": "string"}},
    "limitations": {"type": "string"},
    "scorecard": {
      "oneOf": [
        {"type": "null"},
        {"type": "object", "required": ["overall", "by_stage", "rubric", "weight_policy", "interpretation"], "properties": {
          "overall": {"$ref": "#/$defs/scores"},
          "by_stage": {"type": "object", "additionalProperties": {"$ref": "#/$defs/scores"}}
        }}
      ]
    },
    "controls": {"type": "array", "items": {
      "type": "object", "required": ["id", "stage", "title", "status", "score"],
      "properties": {"id": {"type": "string"}, "stage": {"type": "string"}, "title": {"type": "string"},
        "status": {"$ref": "#/$defs/status"}, "score": {"$ref": "#/$defs/score"},
        "checks": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/checkpoint"}}
      }
    }},
    "boundaries": {"type": "array"},
    "gates": {"type": "array", "items": {
      "type": "object", "required": ["id", "from", "to", "state", "producer", "receiver", "input_evidence", "output_evidence", "blockers", "review"],
      "properties": {"state": {"enum": ["blocked", "evidence_ready", "not_applicable"]}, "blockers": {"type": "array", "items": {"type": "string"}}}
    }},
    "investigations": {"type": "array"},
    "risks": {"type": "array"},
    "evidence_index": {"type": "array", "items": {
      "type": "object", "required": ["id", "path", "locator", "sha256", "kind", "revision", "valid", "reasons"],
      "properties": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "valid": {"type": "boolean"}}
    }}
  },
  "allOf": [{"if": {"properties": {"input_schema_version": {"const": 2}}}, "then": {
    "properties": {"controls": {"minItems": 24, "maxItems": 24, "items": {"required": ["checks"]}}, "gates": {"minItems": 5, "maxItems": 5}, "scorecard": {"type": "object"}}
  }}],
  "$defs": {
    "score": {"type": ["integer", "null"], "minimum": 0, "maximum": 4},
    "status": {"enum": ["supported", "partial", "gap", "unverified", "not_applicable"]},
    "percent": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
    "scores": {
      "type": "object", "required": ["observed_score_percent", "weighted_coverage_percent", "documented_achievement_lower_bound_percent", "total_items", "scored_items", "unverified_items", "not_applicable_items"],
      "properties": {
        "observed_score_percent": {"$ref": "#/$defs/percent"}, "weighted_coverage_percent": {"$ref": "#/$defs/percent"}, "documented_achievement_lower_bound_percent": {"$ref": "#/$defs/percent"},
        "total_items": {"type": "integer", "minimum": 0}, "scored_items": {"type": "integer", "minimum": 0}, "unverified_items": {"type": "integer", "minimum": 0}, "not_applicable_items": {"type": "integer", "minimum": 0}
      }
    },
    "checkpoint": {
      "type": "object", "required": ["id", "question", "status", "score", "claimed_status", "claimed_score", "reviewer", "rationale", "finding", "improvement", "owner", "due", "evidence", "issues"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Z]{3}-[0-9]{2}\\.[1-3]$"}, "question": {"type": "string"},
        "status": {"$ref": "#/$defs/status"}, "score": {"$ref": "#/$defs/score"},
        "reviewer": {"type": "string"}, "rationale": {"type": "string"}, "finding": {"type": "string"}, "improvement": {"type": "string"}, "owner": {"type": "string"}, "due": {"type": "string"},
        "evidence": {"type": "array", "items": {"type": "string"}}, "issues": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
